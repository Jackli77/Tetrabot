# Copy this file to .env and fill in your values.
# This file is the ONLY place secrets live — never commit your real .env.

# --- Discord ---------------------------------------------------------------
# The bot token from the Discord Developer Portal.
BOT_TOKEN="your-discord-bot-token-here"

# --- MongoDB ---------------------------------------------------------------
# The full connection URI of your MongoDB cluster (Atlas or self-hosted).
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net"

# --- Ollama (local LLM, used by !chat and /chat) ---------------------------
# Base URL of the Ollama server.
OLLAMA_HOST="http://localhost:11434"
# The model to use.  Any model of your Ollama server works, including the
# cloud ones ("<model>:cloud").
OLLAMA_MODEL="qwen3:4b"
# How many recent channel messages are sent as conversation context.
CHAT_CONTEXT_MESSAGES="10"

# --- Chatbot behaviour ------------------------------------------------------
# How long the bot waits for the model, in seconds.
OLLAMA_TIMEOUT="180"
# How many tokens the model may generate.  Thinking models spend part of this
# budget on their private reasoning, so keep it large enough to leave room
# for the actual answer.
OLLAMA_NUM_PREDICT="4096"
# The budget used for the retry when the first answer comes back empty.
OLLAMA_RETRY_NUM_PREDICT="8192"
# Sampling temperature.
OLLAMA_TEMPERATURE="0.7"
# How much the model may think before answering: "low", "medium", "high",
# or "" to disable thinking (faster, but the reasoning leaks into the answer).
OLLAMA_THINK="low"
# How long the model stays loaded in memory.  Keeping it warm is what makes
# the bot feel snappy.
OLLAMA_KEEP_ALIVE="10m"
# Stream the answer into the channel as it is generated ("0" disables it).
CHAT_STREAM="1"
# Minimum delay between two edits of the streamed message, in seconds.
CHAT_EDIT_INTERVAL="1.2"
# How many context lines of the conversation are remembered, and for how long
# (in seconds).
CHAT_MEMORY_MESSAGES="20"
CHAT_MEMORY_TTL="21600"

# --- Chatbot tools ----------------------------------------------------------
# The tools the chatbot may use to look things up.  Available:
# get_weather, search_wikipedia, search_web, get_datetime.
# None of them needs an API key.
CHAT_TOOLS="get_weather,search_wikipedia,search_web,get_datetime"
# How many times the model may call tools for a single question.
CHAT_MAX_TOOL_ROUNDS="3"
# How many times a request is retried when the server fails temporarily.
OLLAMA_RETRIES="2"

